ARG GO_VERSION=1.23

FROM golang:${GO_VERSION}-alpine AS backend
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY . .
RUN --mount=type=cache,target=/go/pkg/mod \
    CGO_ENABLED=0 GOOS=linux go build -trimpath \
    -ldflags '-s -w' \
    -o /out/desklink-api ./cmd/apimain.go

FROM node:22-alpine AS frontend
WORKDIR /src/web
COPY web/package.json web/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci
COPY web/ ./
RUN npm run build

FROM alpine:3.22
RUN apk add --no-cache ca-certificates tzdata ffmpeg \
    && addgroup -S -g 10001 desklink \
    && adduser -S -D -H -u 10001 -G desklink desklink
WORKDIR /app
COPY --from=backend /out/desklink-api /app/desklink-api
COPY --from=backend /src/conf /app/conf
COPY --from=backend /src/resources /app/resources
COPY --from=backend /src/docs /app/docs
COPY --from=frontend /src/resources/admin /app/resources/admin
RUN mkdir -p /app/runtime /app/data && chown -R desklink:desklink /app/runtime /app/data
USER desklink
EXPOSE 21114
VOLUME ["/app/runtime"]
HEALTHCHECK --interval=15s --timeout=3s --start-period=20s --retries=5 \
    CMD wget -Y off -q -O /dev/null http://127.0.0.1:21114/api/version || exit 1
ENTRYPOINT ["/app/desklink-api"]
