TZ=Asia/Shanghai

# Docker images
DESKLINK_SERVER_IMAGE=ohoimager/desklink-server:1.4.9
DESKLINK_API_IMAGE=ohoimager/desklink-api:1.4.9

# Public address reachable by DeskLink clients. Do not include a port.
DESKLINK_PUBLIC_HOST=desklink.example.com
# Public API URL, normally behind an HTTPS reverse proxy.
DESKLINK_API_PUBLIC_URL=https://desklink.example.com

# Generate strong random values before deployment.
DESKLINK_HBBS_INTERNAL_KEY=replace-with-a-long-random-secret
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
MYSQL_PASSWORD=replace-with-a-strong-desklink-password
MYSQL_DATABASE=desklink
MYSQL_USER=desklink
MYSQL_BIND_PORT=3306
MYSQL_TLS=false

# DeskLink behavior
DESKLINK_MUST_LOGIN=Y
DESKLINK_ALLOW_REGISTER=false
DESKLINK_SHOW_SWAGGER=0
DESKLINK_WEB_CLIENT=1
DESKLINK_PERSONAL_ADDRESS_BOOK=1
DESKLINK_LANG=zh-CN
RUST_LOG=info
